{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "src/global.d.ts",
    "node_modules/@qwqnt-community/hako-types/types/hako/preload.d.ts",
    "node_modules/@qwqnt-community/hako-types/types/hako/renderer.d.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "types": [
      "@qwqnt/types/preload",
      "@qwqnt/types/renderer"
    ]
  }
}
